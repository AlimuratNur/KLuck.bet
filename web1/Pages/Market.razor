@page "/market/{Address}"
@using PolymarketApp.Services
@inject WalletService Wallet
@inject SolanaService Solana

<a href="/markets">&larr; All markets</a>

@if (m is null)
{
    <p>Loading...</p>
}
else
{
    <h2>@m.Question</h2>
    <p>
        YES <strong>@m.YesPrice.ToString("P1")</strong> &middot;
        NO <strong>@m.NoPrice.ToString("P1")</strong> &middot;
        Ends @endLocal.ToString("g") &middot;
        @(m.Resolved ? $"Resolved: {(m.Winner == 0 ? "YES" : "NO")}" : (ended ? "Trading closed" : "Open"))
    </p>
    <button class="btn btn-sm btn-secondary mb-3" @onclick="Reload">Reload</button>

    @if (Wallet.Address is null)
    {
        <p>Connect your wallet on the <a href="/">home page</a> to trade.</p>
    }
    else
    {
        <p>Your shares: YES <strong>@SolanaService.FromBase(pos.Yes)</strong>, NO <strong>@SolanaService.FromBase(pos.No)</strong></p>

        @if (!m.Resolved && !ended)
        {
            <div class="mb-3">
                <label>Outcome</label>
                <select class="form-select mb-2" @bind="outcome">
                    <option value="0">YES</option>
                    <option value="1">NO</option>
                </select>
            </div>

            <h5>Buy</h5>
            <input class="form-control mb-2" type="number" @bind="buyAmount" @bind:event="oninput" />
            <p>You receive about <strong>@SolanaService.FromBase(BuyShares)</strong> shares.</p>
            <button class="btn btn-success mb-4" disabled="@busy" @onclick="Buy">Buy</button>

            <h5>Sell</h5>
            <input class="form-control mb-2" type="number" @bind="sellAmount" @bind:event="oninput" />
            <p>
                You receive @sellAmount tokens and give up
                <strong>@(SellShares is null ? "too many (pool too small)" : SolanaService.FromBase(SellShares.Value).ToString())</strong> shares.
            </p>
            <button class="btn btn-warning mb-4" disabled="@busy || SellShares is null" @onclick="Sell">Sell</button>
        }

        @if (!m.Resolved && ended && Wallet.Address == m.Resolver)
        {
            <h5>Resolve (you are the resolver)</h5>
            <button class="btn btn-primary me-2" disabled="@busy" @onclick="() => Resolve(0)">YES won</button>
            <button class="btn btn-primary" disabled="@busy" @onclick="() => Resolve(1)">NO won</button>
        }

        @if (m.Resolved)
        {
            <button class="btn btn-success" disabled="@busy" @onclick="Redeem">Redeem winnings</button>
        }
    }

    @if (msg is not null) { <p class="mt-3">@((MarkupString)msg)</p> }
}

@code {
    [Parameter] public string Address { get; set; } = "";

    MarketInfo? m;
    SolanaService.PositionInfo pos = new(0, 0);
    int outcome;
    decimal buyAmount = 10;
    decimal sellAmount = 5;
    bool busy;
    string? msg;

    DateTime endLocal => DateTimeOffset.FromUnixTimeSeconds(m!.EndTime).LocalDateTime;
    bool ended => m is not null && DateTimeOffset.UtcNow.ToUnixTimeSeconds() >= m.EndTime;

    ulong BuyShares => m is null ? 0 : Amm.SharesForBuy(m, outcome, SolanaService.ToBase(buyAmount));
    ulong? SellShares => m is null ? null : Amm.SharesForSell(m, outcome, SolanaService.ToBase(sellAmount));

    protected override async Task OnParametersSetAsync() => await Reload();

    async Task Reload()
    {
        m = await Solana.GetMarketAsync(Address);
        if (m is not null && Wallet.Address is not null)
            pos = await Solana.GetPositionAsync(Address, Wallet.Address);
    }

    Task Buy() => Run(() => Solana.BuyAsync(m!, outcome, SolanaService.ToBase(buyAmount), BuyShares * 99 / 100));
    Task Sell() => Run(() => Solana.SellAsync(m!, outcome, SolanaService.ToBase(sellAmount), SellShares!.Value * 101 / 100));
    Task Resolve(int winner) => Run(() => Solana.ResolveAsync(m!, winner));
    Task Redeem() => Run(() => Solana.RedeemAsync(m!));

    async Task Run(Func<Task<string>> action)
    {
        try
        {
            busy = true; msg = null;
            var sig = await action();
            msg = $"Sent! <a target='_blank' href='https://explorer.solana.com/tx/{sig}?cluster=devnet'>View transaction</a>";
            await Task.Delay(5000);
            await Reload();
        }
        catch (Exception e) { msg = $"Error: {e.Message}"; }
        finally { busy = false; }
    }
}