@inherits LayoutComponentBase
@implements IDisposable
@using PolymarketApp.Services
@inject WalletService Wallet
@inject ApiService Api
@inject SolanaService Solana
@inject IJSRuntime JS

<header class="k-nav">
    <div class="k-nav-inner">
        <a class="k-brand" href="/">
            <span class="k-logo">K</span>KLuck<span class="k-dot">.bet</span>
            <span class="k-badge">KBTU</span>
            
        </a>

        <div class="k-nav-right">
            @if (Wallet.Address is null)
            {
                <button class="k-btn k-btn-primary" @onclick="Connect">Connect wallet</button>
            }
            else
            {
                <span class="k-balance" title="Your test tokens">🪙 @SolanaService.Fmt(balance)</span>
                @if (balance < 1_000_000)
                {
                    <button class="k-btn k-btn-primary k-btn-sm" disabled="@claiming" @onclick="ClaimTokens">
                        @(claiming ? "Sending..." : "Get test tokens")
                    </button>
                }
                <button class="k-me" @onclick="() => menuOpen = !menuOpen">
                    <Avatar Address="@Wallet.Address" Emoji="@MyEmoji" Size="34" />
                    <span class="k-me-name">@DisplayName</span>
                </button>

                @if (menuOpen)
                {
                    <div class="k-overlay" @onclick="() => menuOpen = false"></div>
                    <div class="k-menu">
                        <div class="k-menu-head">
                            <Avatar Address="@Wallet.Address" Emoji="@MyEmoji" Size="48" />
                            <div>
                                <strong>@DisplayName</strong>
                                <div class="k-muted" style="font-size:.8rem">@ApiService.Short(Wallet.Address)</div>
                            </div>
                        </div>
                        <button class="k-menu-item" @onclick="ClaimTokens">🪙 Get test tokens</button>
                        <button class="k-menu-item" @onclick="OpenEdit">✏️ Edit profile</button>
                        <button class="k-menu-item" @onclick="CopyAddress">📋 Copy wallet address</button>
                        <button class="k-menu-item" @onclick="Disconnect">🚪 Disconnect</button>
                    </div>
                }
            }
        </div>
    </div>
</header>

@if (editing && Wallet.Address is not null)
{
    <div class="k-modal" @onclick="() => editing = false">
        <div class="k-card k-modal-card" @onclick="() => { }" @onclick:stopPropagation="true">
            <h3>Edit profile</h3>
            <div class="k-center"><Avatar Address="@Wallet.Address" Emoji="@editEmoji" Size="72" /></div>

            <div class="k-label">Display name</div>
            <input class="k-input" maxlength="24" placeholder="e.g. Aigerim" @bind="editName" @bind:event="oninput" />

            <div class="k-label">Avatar</div>
            <div class="k-emojis">
                @foreach (var e in Emojis)
                {
                    <button class="k-emoji @(editEmoji == e ? "active" : "")" @onclick="() => editEmoji = e">@e</button>
                }
            </div>
            <p class="k-hint">Everyone on KLuck.bet will see your name and avatar. You'll be asked to sign a message once.</p>

            <div class="k-modal-actions">
                <button class="k-btn k-btn-ghost" @onclick="() => editing = false">Cancel</button>
                <button class="k-btn k-btn-primary" @onclick="SaveProfile">Save</button>
            </div>
        </div>
    </div>
}
@if (info is not null) { <div class="k-alert">@info</div> }

<div class="k-shell">
    <aside class="k-side">
        @if (Wallet.Address is not null)
        {
            <button class="k-side-me" @onclick="OpenEdit">
                <Avatar Address="@Wallet.Address" Emoji="@MyEmoji" Size="44" />
                <span>@DisplayName</span>
            </button>
        }
        <NavLink class="k-side-item" href="" Match="NavLinkMatch.All"><span>🏠</span> Feed</NavLink>
        <NavLink class="k-side-item" href="my"><span>🎯</span> My bets</NavLink>
        <a class="k-side-item" href="/?new=1"><span>➕</span> New bet</a>
        <button class="k-side-item" @onclick="OpenEdit"><span>👤</span> Profile</button>
        <div class="k-side-note">Unofficial KBTU student project. Devnet demo, test tokens only.</div>
    </aside>

    <main class="k-main">
        @if (error is not null) { <div class="k-alert">@error</div> }
        @Body
    </main>
</div>

@code {
    static readonly string[] Emojis =
        { "😀", "😎", "🦊", "🐯", "🦄", "🎓", "🔥", "⚡", "🚀", "🎲", "🐼", "🦁" };

    string? error;
    ulong balance;
    bool menuOpen, editing;
    string editName = "", editEmoji = "";
    Action? handler;
    CancellationTokenSource? cts;

    string? MyEmoji => Wallet.Address is null ? null : Api.Get(Wallet.Address).Emoji;

    string DisplayName
    {
        get
        {
            var n = Api.Get(Wallet.Address!).Name;
            return string.IsNullOrWhiteSpace(n) ? ApiService.Short(Wallet.Address!) : n!;
        }
    }

    protected override void OnInitialized()
    {
        handler = () => InvokeAsync(OnWalletChanged);
        Wallet.Changed += handler;
        cts = new CancellationTokenSource();
        _ = PollAsync(cts.Token);
    }

    public void Dispose()
    {
        cts?.Cancel();
        if (handler is not null) Wallet.Changed -= handler;
    }

    async Task OnWalletChanged()
    {
        if (Wallet.Address is null) { balance = 0; menuOpen = false; }
        else
        {
            await Api.LoadProfilesAsync(new[] { Wallet.Address });
            await RefreshBalance();
        }
        StateHasChanged();
    }

    async Task RefreshBalance()
    {
        if (Wallet.Address is null) return;
        try { balance = await Solana.GetTokenBalanceAsync(Wallet.Address); } catch { }
    }

    async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(8));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await RefreshBalance();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    async Task Connect()
    {
        try { error = null; await Wallet.ConnectAsync(); }
        catch (Exception e) { error = e.Message; }
    }

    async Task Disconnect() { menuOpen = false; await Wallet.DisconnectAsync(); }

    async Task CopyAddress()
    {
        menuOpen = false;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Wallet.Address);
    }

    void OpenEdit()
    {
        menuOpen = false;
        if (Wallet.Address is null) { error = "Connect your wallet first."; return; }
        editName = Api.Get(Wallet.Address).Name ?? "";
        editEmoji = Api.Get(Wallet.Address).Emoji ?? "";
        editing = true;
    }

    async Task SaveProfile()
    {
        try { error = null; await Api.SaveProfileAsync(editName.Trim(), editEmoji); }
        catch (Exception e) { error = e.Message; }
        editing = false;
    }
    
    string? info;
    bool claiming;

    async Task ClaimTokens()
    {
        try
        {
            menuOpen = false; claiming = true; error = null; info = null;
            var r = await Api.ClaimFaucetAsync();
            info = $"You received {r.Tokens} test tokens" + (r.Sol ? " and a little SOL for fees." : ".");
            await Task.Delay(4000);
            await RefreshBalance();
        }
        catch (Exception e) { error = e.Message; }
        finally { claiming = false; }
    }
}