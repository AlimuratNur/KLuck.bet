@page "/"
@implements IDisposable
@using PolymarketApp.Services
@inject WalletService Wallet
@inject SolanaService Solana
@inject ApiService Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<section class="k-hero">
    <h1>Bet on campus life.<br /><span class="k-grad">Settle it on-chain.</span></h1>
    <p>Will the final exam be on December 10th? Challenge a friend, let others join either side or just watch, and the winners split the pool automatically.</p>
    <div class="k-hero-actions">
        <button class="k-btn k-btn-primary k-btn-lg" @onclick="() => showCreate = !showCreate">+ New bet</button>
        
    </div>
</section>

@if (showCreate)
{
    <div class="k-card k-form">
        <h3>Create a bet</h3>
        @if (Wallet.Address is null)
        {
            <p class="k-muted" style="margin-top:.8rem">Connect your wallet (top right) to create a bet.</p>
        }
        else
        {
            <div class="k-feed">
                @foreach (var b in Filtered)
                {
                    <article class="k-card k-post">
                        <header class="k-post-head">
                            <Avatar Address="@b.Creator" Emoji="@EmojiFor(b.Creator)" Size="44" />
                            <div class="k-post-who">
                                <div class="k-post-name">@NameFor(b.Creator)</div>
                                <div class="k-muted k-post-sub">@b.PostedAgo · closes @b.CloseLocal.ToString("d MMM, HH:mm")</div>
                            </div>
                            <span class="k-chip k-chip-@b.StatusClass">@b.StatusText</span>
                        </header>

                        <a class="k-post-title" href="/bet/@b.Address">@b.Title</a>

                        <div class="k-split"><span class="k-yes">YES @b.YesPctText%</span><span class="k-no">NO @b.NoPctText%</span></div>
                        <div class="k-bar"><div class="k-bar-yes" style="width:@(b.YesWidth)%"></div></div>
                        <div class="k-post-stats k-muted">🪙 @SolanaService.Fmt(b.Total) in the pool</div>

                        <footer class="k-post-actions">
                            @if (b.CanJoin)
                            {
                                <a class="k-act k-act-yes" href="/bet/@b.Address?side=0">Join YES</a>
                                <a class="k-act k-act-no" href="/bet/@b.Address?side=1">Join NO</a>
                            }
                            else
                            {
                                <a class="k-act" href="/bet/@b.Address">View result</a>
                            }
                            <a class="k-act" href="/bet/@b.Address#comments">💬 @CountFor(b.Address)</a>
                            <button class="k-act" @onclick="() => Share(b.Address)">🔗 Share</button>
                        </footer>
                    </article>
                }
            </div>
        }
    </div>
}

@if (msg is not null) { <div class="k-alert">@((MarkupString)msg)</div> }

<div class="k-tabs">
    <button class="k-tab @(filter == "open" ? "active" : "")" @onclick='() => filter = "open"'>Open</button>
    <button class="k-tab @(filter == "wait" ? "active" : "")" @onclick='() => filter = "wait"'>Waiting for result</button>
    <button class="k-tab @(filter == "done" ? "active" : "")" @onclick='() => filter = "done"'>Finished</button>
</div>

@if (bets is null)
{
    <p class="k-empty">Loading bets...</p>
}
else if (!Filtered.Any())
{
    <p class="k-empty">Nothing here yet. Be the first to start a bet!</p>
}
else
{
    <div class="k-grid">
        @foreach (var b in Filtered)
        {
            <a class="k-card k-bet" href="/bet/@b.Address">
                <div class="k-row">
                    <span class="k-chip k-chip-@b.StatusClass">@b.StatusText</span>
                    <span class="k-muted k-small" style="margin:0">@b.CloseLocal.ToString("d MMM, HH:mm")</span>
                </div>
                <h3>@b.Title</h3>
                <div class="k-split"><span class="k-yes">YES @b.YesPctText%</span><span class="k-no">NO @b.NoPctText%</span></div>
                <div class="k-bar"><div class="k-bar-yes" style="width:@(b.YesWidth)%"></div></div>
                <div class="k-muted k-small">Pool: @SolanaService.Fmt(b.Total) tokens</div>
            </a>
        }
    </div>
}

@code {
    List<BetInfo>? bets;
    string filter = "open";
    bool showCreate, busy;
    string? msg;

    string title = "";
    DateTime closeDate = DateTime.Today.AddDays(1);
    
    decimal stake = 10;
    int side;
    string judge = "";
    Action? handler;
    
    CancellationTokenSource? cts;

    Dictionary<string, int> counts = new();

    [SupplyParameterFromQuery(Name = "new")] public string? NewBet { get; set; }

    protected override void OnParametersSet()
    {
        if (NewBet == "1") showCreate = true;
    }

    int CountFor(string bet) => counts.TryGetValue(bet, out var n) ? n : 0;
    
    IEnumerable<BetInfo> Filtered => (bets ?? new()).Where(b => filter switch
    {
        "open" => b.CanJoin,
        "wait" => b.WaitingForResult,
        _ => b.Status != 0
    });

    protected override async Task OnInitializedAsync()
    {
        handler = () => InvokeAsync(StateHasChanged);
        Wallet.Changed += handler;
        await Load();

        cts = new CancellationTokenSource();
        _ = PollAsync(cts.Token);
    }

    async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (!busy) await Load(silent: true);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        cts?.Cancel();
        if (handler is not null) Wallet.Changed -= handler;
    }

    

    async Task Load(bool silent = false)
    {
        try
        {
            bets = await Solana.GetBetsAsync();
            counts = await Api.GetCountsAsync();
            await Api.LoadProfilesAsync(bets.Select(b => b.Creator));
        }
        catch (Exception e)
        {
            if (!silent) msg = $"Could not load bets: {e.Message}";
            bets ??= new();
        }
    }

    async Task Create()
    {
        try
        {
            busy = true; msg = null;
            if (string.IsNullOrWhiteSpace(title)) throw new Exception("Write what the bet is about.");
            if (CloseAt <= DateTime.Now) throw new Exception("Pick a closing time in the future.");
            var close = new DateTimeOffset(CloseAt).ToUnixTimeSeconds();
            var who = string.IsNullOrWhiteSpace(judge) ? Wallet.Address! : judge.Trim();
            var sig = await Solana.CreateBetAsync(title.Trim(), close, who, side, SolanaService.ToBase(stake));
            msg = $"Bet sent! <a target='_blank' href='https://explorer.solana.com/tx/{sig}?cluster=devnet'>View transaction</a>. It appears in the list in a few seconds.";
            showCreate = false; title = "";
            await Task.Delay(6000);
            await Load();
        }
        catch (Exception e) { msg = $"Error: {e.Message}"; }
        finally { busy = false; }
    }
    
    
    string closeTime = "12:00";

    static readonly string[] Times =
        Enumerable.Range(0, 48).Select(i => $"{i / 2:00}:{i % 2 * 30:00}").ToArray();

    DateTime CloseAt => closeDate.Date + TimeSpan.Parse(closeTime);

    string Relative
    {
        get
        {
            var d = CloseAt - DateTime.Now;
            if (d.TotalMinutes <= 0) return "in the past!";
            if (d.TotalHours < 24) return $"in {(int)d.TotalHours}h {d.Minutes}m";
            return $"in {(int)d.TotalDays} days";
        }
    }

// Rounds up to the next 30 minutes so it matches the time dropdown.
    void SetClose(DateTime t)
    {
        var step = TimeSpan.FromMinutes(30).Ticks;
        t = new DateTime((t.Ticks + step - 1) / step * step);
        closeDate = t.Date;
        closeTime = t.ToString("HH:mm");
    }
    
    string NameFor(string address) => Api.NameOf(address);
    string? EmojiFor(string address) => Api.Get(address).Emoji;

    

    async Task Share(string address)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Nav.BaseUri + "bet/" + address);
        msg = "Link copied. Send it to a friend!";
    }
}
